	column 'Mês Ano'
		dataType: string
		lineageTag: 3e9b7c15-0d4a-4f2e-8b61-c5a2d7e9f083
		summarizeBy: none
		sourceColumn: Mês Ano
		sortByColumn: 'AnoMes'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = User

	column 'Período com Vendas'
		dataType: boolean
		isHidden
		lineageTag: c7d18e42-95ab-4e3f-b2c6-1a8f04d6e95b
		summarizeBy: none
		sourceColumn: Período com Vendas

		changedProperty = IsHidden

		annotation SummarizationSetBy = User


	partition dCalendario = m
		mode: import
		source =
				let
					// Calendário de anos completos, do 1º ao último ano com vendas na fato
					PrimeiraVenda = List.Min(fVendas[#"Data Pedido"]),
					UltimaVenda = List.Max(fVendas[#"Data Pedido"]),
					DataInicial = #date(Date.Year(PrimeiraVenda), 1, 1),
					DataFinal = #date(Date.Year(UltimaVenda), 12, 31),
					ListaDatas = List.Dates(DataInicial, Duration.Days(DataFinal - DataInicial) + 1, #duration(1, 0, 0, 0)),
					NomesMeses = {"Jan", "Fev", "Mar", "Abr", "Mai", "Jun", "Jul", "Ago", "Set", "Out", "Nov", "Dez"},
					Calendario = Table.FromList(ListaDatas, Splitter.SplitByNothing(), type table [Data = date]),
					AddAno = Table.AddColumn(Calendario, "Ano", each Date.Year([Data]), Int64.Type),
					AddTrimestre = Table.AddColumn(AddAno, "Trimestre", each "T" & Text.From(Date.QuarterOfYear([Data])), type text),
					AddNumMes = Table.AddColumn(AddTrimestre, "Nº Mês", each Date.Month([Data]), Int64.Type),
					AddMes = Table.AddColumn(AddNumMes, "Mês", each NomesMeses{[#"Nº Mês"] - 1}, type text),
					AddAnoMes = Table.AddColumn(AddMes, "AnoMes", each [Ano] * 100 + [#"Nº Mês"], Int64.Type),
					AddMesAno = Table.AddColumn(AddAnoMes, "Mês Ano", each [#"Mês"] & "/" & Text.End(Text.From([Ano]), 2), type text),
					AddPeriodoComVendas = Table.AddColumn(AddMesAno, "Período com Vendas", each [Data] <= UltimaVenda, type logical)
				in
					AddPeriodoComVendas

	annotation PBI_ResultType = Table
