model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DimCustomer","DimDate","DimProduct","FactSales","_Measures"]

annotation PBI_ProTooling = ["DaxQueryView_Desktop","DevMode"]

ref table DimCustomer
ref table DimDate
ref table DimProduct
ref table FactSales
ref table _Measures
ref table 'Metric Selector'

ref cultureInfo en-US

